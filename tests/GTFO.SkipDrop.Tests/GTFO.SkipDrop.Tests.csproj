<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameName>GTFO</GameName>
    <Profile>Easy Mode DEV</Profile>

    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>

    <BepInEx>$(AppData)\Thunderstore Mod Manager\DataFolder\$(GameName)\profiles\$(GameName) - $(Profile)\BepInEx</BepInEx>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GTFO.SkipDrop\GTFO.SkipDrop.csproj" />
  </ItemGroup>

  <!-- The plugin references these with Private="false" (the game supplies them), so the tests copy their own. -->
  <ItemGroup>
    <Reference Include="$(BepInEx)\core\0Harmony.dll" />
    <Reference Include="$(BepInEx)\core\BepInEx.Core.dll" />
    <Reference Include="$(BepInEx)\core\BepInEx.Unity.IL2CPP.dll" />
    <Reference Include="$(BepInEx)\core\Il2CppInterop.Common.dll" />
    <Reference Include="$(BepInEx)\core\Il2CppInterop.Runtime.dll" />
  </ItemGroup>

</Project>
